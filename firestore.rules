rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.id == request.auth.uid
        && data.email is string
        && data.email.size() <= 254;
    }

    function isValidSavedPaper(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'board', 'classLevel', 'subject', 'totalMarks'])
        && data.userId == userId
        && data.title is string
        && data.title.size() <= 300
        && data.totalMarks is number
        && data.totalMarks > 0;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      // User's Saved Question Papers Subcollection
      match /papers/{paperId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(paperId) && isValidSavedPaper(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
